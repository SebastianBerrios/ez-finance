{
  "name": "ez-finance",
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:remote": "node --env-file=.env.remote.local node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "start:remote": "node --env-file=.env.remote.local node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --project=integration",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-slot": "^1.3.2",
    "@supabase/ssr": "^0.6",
    "@supabase/supabase-js": "^2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "next": "^15",
    "next-themes": "^0.4",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-plugin-boundaries": "^5",
    "eslint-plugin-import": "^2",
    "fast-check": "^4.9.0",
    "jsdom": "^25",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "supabase": "^2",
    "tailwindcss": "^4",
    "tw-animate-css": "latest",
    "typescript": "^5.6",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "allowBuild": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}

# Supabase project credentials
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
#
# Local vs Remote:
#   .env.local             -> remote (production) mvp-lab project credentials
#   .env.development.local -> local Supabase stack (overrides when running pnpm dev or tests)
#   .env.development.local is also git-ignored; safe to store local stack keys there.
#
# Variable reference:
#   NEXT_PUBLIC_SUPABASE_URL             - PostgREST/Auth base URL (safe for browser)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY - Publishable (anon) key (safe for browser)

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

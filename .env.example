# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# --- Google OAuth (local dev only) ---
# These are only needed when running the local Supabase stack (supabase start)
# and testing Google Sign-In locally. In production, configure the provider
# directly in the Supabase dashboard (Auth > Providers > Google).
#
# To obtain:
#   1. Google Cloud Console > Credentials > Create OAuth 2.0 Client ID (Web app)
#   2. Add authorized redirect URI: http://localhost:54331/auth/v1/callback (local)
#      For hosted remote: https://vzxrsvqnxkoiuwvdozxv.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<your-google-oauth-client-secret>

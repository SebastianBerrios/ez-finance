# --- Supabase (required) ---
# Local stack URL. Set ONLY in .env.test.local — it is the switch that enables
# the integration suite (bootstrap.integration.test.ts skips without it).
SUPABASE_TEST_URL=http://127.0.0.1:54331

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# --- Google OAuth (local dev only) ---
# These are only needed when running the local Supabase stack (supabase start)
# and testing Google Sign-In locally. In production, configure the provider
# directly in the Supabase dashboard (Auth > Providers > Google).
#
# To obtain:
#   1. Google Cloud Console > Credentials > Create OAuth 2.0 Client ID (Web app)
#   2. Add authorized redirect URI: http://localhost:54331/auth/v1/callback (local)
#      For hosted remote: https://vzxrsvqnxkoiuwvdozxv.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<your-google-oauth-client-secret>

# --- Server-only secrets (NEVER prefix these with NEXT_PUBLIC_) ---
# Anything named NEXT_PUBLIC_* is inlined into the browser bundle. These two are
# not, and they must never be: both are root credentials for the deletion
# pipeline. Set them in the Vercel project (Environment Variables), not in any
# client-visible config.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS completely. It is read by
# src/shared/infrastructure/supabase/service-client.ts and used by exactly one
# caller: the scheduled account-deletion worker, which finalizes accounts that
# have no session at all.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
#
# CRON_SECRET authenticates GET /api/cron/process-deletions (the Vercel Cron
# convention: `Authorization: Bearer $CRON_SECRET`). `api/` is excluded from the
# middleware matcher, so this token is the ONLY thing standing between the
# public internet and a 1000-account erasure endpoint. Use a long random value.
CRON_SECRET=<a-long-random-string>
